{
  "name": "turkce-365",
  "version": "1.0.0",
  "private": true,
  "description": "Türkçe 365 — a local-first personal Turkish tutor (A0 → A2/B1).",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vocab:build": "tsx scripts/build-vocab.ts",
    "seed": "tsx scripts/seed.ts",
    "lesson": "tsx scripts/generate-lesson.ts",
    "lesson:force": "tsx scripts/generate-lesson.ts --force",
    "scheduler:setup": "tsx scripts/setup-scheduler.ts",
    "check:claude": "tsx scripts/check-claude.ts",
    "backup": "tsx scripts/backup.ts",
    "worker": "tsx scripts/worker.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@vercel/functions": "^3.11.1",
    "diff": "^9.0.0",
    "next": "15.5",
    "node-notifier": "^10.0.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "3.25"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/node-notifier": "^8.0.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "3.2"
  }
}
